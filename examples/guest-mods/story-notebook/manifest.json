{
  "format_version": 1,
  "id": "story-notebook",
  "name": "The storyteller's lantern",
  "version": "0.4.0",
  "game_id": "wwhd",
  "minimum_manager_version": "1.5.0",
  "kind": "guest",
  "guest": {
    "api_version": 1,
    "elf": "mod.elf"
  },
  "npc_catalogue": 1,
  "quests_format": 1,
  "quests": [
    {
      "id": "lantern",
      "title": "The storyteller's lantern",
      "journal": "on_enable",
      "start": {
        "text": "Check a Rito postbox for a letter."
      },
      "letter": {
        "id": "lantern",
        "sender": "The storyteller",
        "text": "Dear Link,\na storm took my lantern and my mast,\nso I can't tell my tales on Windfall\nthis year. I enclose a notebook to keep\nthis tale in, and a sealed letter for my\nold friend who keeps Windfall's light.",
        "encloses": [
          "notebook",
          "letter:friend"
        ]
      },
      "reward": {
        "text": "100 rupees",
        "item": "rupee_orange"
      },
      "steps": [
        {
          "n": 1,
          "text": "Bring the storyteller's letter to his old friend who keeps Windfall's light.",
          "npc": {
            "who": "windfall-light-keeper",
            "when": {
              "carries": "letter:friend"
            },
            "lines": [
              "A letter from my old friend? Thank you!",
              "I'll keep a light burning for his tales.",
              "He paid in stories; let me pay you in rupees."
            ],
            "then": {
              "give": "rupee_orange",
              "take": "letter:friend",
              "complete": true
            }
          }
        }
      ]
    }
  ]
}
