      "journal": "on_enable",
      "letter": {
        "id": "sky",
        "sender": "An old sailor",
        "text": "Dear Link, a great bird has been seen over the pier on Outset, near the lookout. They say it carries travellers up to an island floating in the sky. Walk out along the pier and see for yourself!"
      },
      "reward": {
        "item": "rupee_orange",
        "text": "A heart container from the island, and 100 rupees"
      },
      "start": {
        "text": "Check a Rito postbox for a letter."
      },
